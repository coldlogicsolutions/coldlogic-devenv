.DS_Store

# devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# Generated by devenv (`claude.code` in devenv.nix) as Nix store symlinks;
# change the settings there, not here.
/.claude/settings.json
/.claude/worktrees/
.mcp.json
.pre-commit-config.yaml
# The shell generates OpenSpec's Claude Code skills and commands
# (coldlogic:openspec-files in devenv.nix).
/.claude/skills/openspec-*/
/.claude/commands/opsx/

# The cache job copies the module's lock into each fixture.
/tests/fixtures/*/devenv.lock
/tests/fixtures/*/.devenv*
/tests/fixtures/*/.claude/
/tests/fixtures/*/.mcp.json
/tests/fixtures/*/.pre-commit-config.yaml

# Python bytecode from running the guard tests.
__pycache__/
